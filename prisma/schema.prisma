datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ClothingItem {
  id            String    @id @default(cuid())
  name          String
  category      String
  imageUrl      String
  description   String?
  dateAdded     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  outfits       Outfit[]  @relation("OutfitToClothingItem")
}

model Outfit {
  id            String          @id @default(cuid())
  name          String
  clothingItems ClothingItem[]  @relation("OutfitToClothingItem")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  plannedOutfit PlannedOutfit[]
}

model PlannedOutfit {
  id        String   @id @default(cuid())
  date      DateTime @unique // Unique date for planning
  outfitId  String
  outfit    Outfit   @relation(fields: [outfitId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outfitId])
}
